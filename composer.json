{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "composer/semver": "3.5.2",
        "guzzlehttp/guzzle": "7.16.0",
        "laravel/framework": "13.38.0",
        "laravel/sanctum": "4.3.3",
        "laravel/tinker": "3.0.2",
        "lesstif/jira-cloud-restapi": "^1.9",
        "lexisother/buddy-works-php-api": "^1.6",
        "livewire/livewire": "3.8.11",
        "ohdearapp/ohdear-php-sdk": "4.7.0",
        "spatie/laravel-data": "4.23.0",
        "spatie/laravel-permission": "^6.0",
        "symfony/yaml": "7.4.21"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9.1",
        "laravel/pint": "1.32.1",
        "laravel/sail": "1.69.0",
        "mockery/mockery": "1.6.15",
        "nunomaduro/collision": "8.9.5",
        "phpunit/phpunit": "11.5.57",
        "spatie/laravel-ignition": "2.12.1"
    },
    "autoload": {
        "files": ["app/helpers.php"],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/lexisother/buddy-works-php-api",
            "no-api": true
        }
    ]
}
